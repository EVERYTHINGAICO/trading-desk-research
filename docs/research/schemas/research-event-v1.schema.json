{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EVERYTHINGAICO/trading-desk-research/docs/research/schemas/research-event-v1.schema.json",
  "title": "Causal research event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "dataset_id", "experiment_id",
    "instrument", "source", "exchange_event_ms", "received_ms",
    "decision_ms", "quality", "payload"
  ],
  "properties": {
    "schema_version": {"const": "research-event-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "event_id": {"type": ["string", "null"]},
    "decision_id": {"type": ["string", "null"]},
    "strategy_version": {"type": ["string", "null"]},
    "config_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "instrument": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "exchange_event_ms": {"type": "integer", "minimum": 0},
    "exchange_available_ms": {"type": ["integer", "null"], "minimum": 0},
    "received_ms": {"type": "integer", "minimum": 0},
    "decision_ms": {"type": "integer", "minimum": 0},
    "quality": {
      "enum": ["OBSERVED", "MISSING", "STALE", "UNVERIFIABLE", "CORRECTED", "SYNTHETIC"]
    },
    "quality_reason": {"type": ["string", "null"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
